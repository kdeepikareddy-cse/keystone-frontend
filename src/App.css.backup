/* =========================================================
   KEYSTONE - FIELD SERVICE MANAGEMENT PLATFORM
   Professional Dashboard UI
   ========================================================= */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;
  background: #f1f5f9;
  color: #0f172a;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

/* =========================================================
   APP
   ========================================================= */

.app {
  min-height: 100vh;
  background: #f1f5f9;
}

/* =========================================================
   HEADER
   ========================================================= */

.header {
  min-height: 76px;
  padding: 14px 40px;
  background: #0f172a;
  color: white;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.18);
}

.header h1 {
  margin: 0;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 1px;
}

.header p {
  margin: 4px 0 0;
  color: #94a3b8;
  font-size: 13px;
}

.user {
  display: flex;
  align-items: center;
  gap: 11px;
}

.user strong {
  display: block;
  font-size: 14px;
  color: #ffffff;
}

.user small {
  display: block;
  margin-top: 2px;
  color: #94a3b8;
  font-size: 12px;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #2563eb;
  color: white;
  font-weight: 800;
  font-size: 15px;

  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard {
  width: min(1400px, 94%);
  margin: 0 auto;
  padding: 32px 0 50px;
}

.welcome {
  margin-bottom: 24px;
}

.welcome h2 {
  margin: 0;
  font-size: 30px;
  font-weight: 800;
  color: #0f172a;
}

.welcome p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 15px;
}

/* =========================================================
   ERROR
   ========================================================= */

.error {
  margin-bottom: 20px;
  padding: 13px 16px;
  border-radius: 10px;

  background: #fee2e2;
  border: 1px solid #fecaca;
  color: #991b1b;

  font-size: 14px;
  font-weight: 600;
}

/* =========================================================
   STATISTICS
   ========================================================= */

.stats {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.card {
  position: relative;

  min-height: 130px;
  padding: 22px;

  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 15px;

  display: flex;
  align-items: center;
  gap: 17px;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, 0.04);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 10px 25px rgba(15, 23, 42, 0.09);
}

.card .icon {
  width: 52px;
  height: 52px;
  min-width: 52px;

  border-radius: 13px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eff6ff;
  color: #2563eb;

  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.4px;
}

.card:nth-child(2) .icon {
  background: #f0fdf4;
  color: #16a34a;
}

.card:nth-child(3) .icon {
  background: #ecfdf5;
  color: #059669;
}

.card:nth-child(4) .icon {
  background: #fff1f2;
  color: #e11d48;
}

.card h3 {
  margin: 0 0 5px;
  font-size: 14px;
  font-weight: 700;
  color: #475569;
}

.card strong {
  display: block;
  font-size: 29px;
  line-height: 1;
  color: #0f172a;
}

.card p {
  margin: 6px 0 0;
  color: #94a3b8;
  font-size: 12px;
}

/* =========================================================
   CONTENT GRID
   ========================================================= */

.content-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

/* =========================================================
   PANELS
   ========================================================= */

.panel {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 15px;
  padding: 22px;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, 0.04);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 16px;
}

.panel-header h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 800;
  color: #0f172a;
}

.panel-header p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 13px;
}

/* =========================================================
   WORK ORDER ROW
   ========================================================= */

.work-order {
  min-height: 72px;
  padding: 15px 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  border-bottom: 1px solid #eef2f7;
}

.work-order:last-child {
  border-bottom: none;
}

.work-order h3 {
  margin: 0;

  color: #0f172a;
  font-size: 14px;
  font-weight: 750;
}

.work-order p {
  margin: 5px 0 0;

  color: #64748b;
  font-size: 12px;
}

.work-order small {
  display: block;
  margin-top: 7px;

  color: #64748b;
  font-size: 12px;
}

/* =========================================================
   PRIORITY
   ========================================================= */

.priority {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 70px;
  padding: 6px 10px;

  border-radius: 999px;

  background: #f1f5f9;
  color: #475569;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.3px;
}

/* =========================================================
   ORDER INFO
   ========================================================= */

.order-info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;

  flex-wrap: wrap;
}

/* =========================================================
   SELECTS
   ========================================================= */

select {
  cursor: pointer;
}

select:focus,
input:focus,
textarea:focus {
  outline: none;
  border-color: #2563eb !important;

  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.1);
}

/* =========================================================
   TECHNICIANS
   ========================================================= */

.technician {
  padding: 15px 0;

  display: flex;
  align-items: center;
  gap: 13px;

  border-bottom: 1px solid #eef2f7;
}

.technician:last-child {
  border-bottom: none;
}

.tech-avatar {
  width: 42px;
  height: 42px;
  min-width: 42px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eff6ff;
  color: #2563eb;

  font-size: 15px;
  font-weight: 800;
}

.tech-details {
  flex: 1;
}

.tech-details h3 {
  margin: 0;

  font-size: 14px;
  color: #0f172a;
}

.tech-details p {
  margin: 4px 0 0;

  font-size: 12px;
  color: #64748b;
}

/* =========================================================
   FORMS
   ========================================================= */

label {
  display: block;

  color: #334155;
  font-size: 13px;
  font-weight: 700;
}

input,
textarea,
select {
  font-size: 13px;
}

input,
textarea {
  background: white;
  color: #0f172a;
}

textarea {
  line-height: 1.5;
}

/* =========================================================
   BUTTONS
   ========================================================= */

button {
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
}

button:active {
  transform: translateY(0);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* =========================================================
   QUICK ACTIONS
   ========================================================= */

.action {
  min-height: 90px;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  background: white;
  color: #0f172a;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 8px;

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  box-shadow:
    0 2px 7px rgba(15, 23, 42, 0.04);

  transition: all 0.2s ease;
}

.action:hover {
  border-color: #93c5fd;

  background: #f8fbff;

  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.08);

  transform: translateY(-3px);
}

.action span {
  font-size: 23px;
}

/* =========================================================
   EMPTY / LOADING
   ========================================================= */

.empty {
  padding: 30px 10px;

  text-align: center;

  color: #94a3b8;
  font-size: 13px;
}

.loading {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #f1f5f9;

  color: #2563eb;

  font-size: 16px;
  font-weight: 700;
}

/* =========================================================
   REPORTS
   ========================================================= */

.panel .stats {
  margin-top: 8px;
}

/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 1000px) {

  .stats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .content-grid {
    grid-template-columns: 1fr;
  }

  .dashboard {
    width: 92%;
  }

  .header {
    padding: 14px 25px;
  }
}

/* =========================================================
   RESPONSIVE - MOBILE
   ========================================================= */

@media (max-width: 650px) {

  .header {
    padding: 14px 18px;

    align-items: flex-start;
    gap: 12px;
  }

  .header h1 {
    font-size: 20px;
  }

  .header p {
    font-size: 11px;
  }

  .user small {
    display: none;
  }

  .avatar {
    width: 34px;
    height: 34px;
  }

  .dashboard {
    width: 94%;
    padding-top: 24px;
  }

  .welcome h2 {
    font-size: 25px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .content-grid {
    grid-template-columns: 1fr;
  }

  .panel {
    padding: 17px;
  }

  .work-order {
    align-items: flex-start;
    flex-direction: column;
  }

  .order-info {
    width: 100%;
    justify-content: flex-start;
  }

  .technician {
    flex-wrap: wrap;
  }
}

/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #e2e8f0;
}

::-webkit-scrollbar-thumb {
  background: #94a3b8;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #64748b;
}